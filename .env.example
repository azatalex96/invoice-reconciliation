# Environment variable names used by this exercise. No values are committed.
# Only needed for live runs, e.g.  python -m recon process --provider gemini
MODEL_API_KEY=
# saved (default, offline replay) | gemini | claude
MODEL_PROVIDER=
# Optional model override; defaults: gemini-3.5-flash-lite (gemini), claude-opus-5-5 (claude)
MODEL_NAME=
